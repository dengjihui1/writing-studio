{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dengjihui1/writing-studio/evals/rubric.schema.json",
  "title": "Writing Studio single-output rubric record",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "grader", "integrity_failures", "scores", "decision", "notes"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "string"},
    "grader": {"type": "string", "enum": ["human", "model-assisted", "hybrid"]},
    "integrity_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fabricated-fact",
          "fabricated-citation",
          "fabricated-quotation",
          "fabricated-experience",
          "protected-text-changed",
          "claim-strength-drift",
          "edit-authority-violation",
          "detector-guarantee",
          "evasion-tactic"
        ]
      },
      "uniqueItems": true
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_genre_fit", "fidelity", "structural_coherence", "clarity_precision", "voice_specificity", "detector_discipline", "delivery_usefulness"],
      "properties": {
        "task_genre_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "fidelity": {"type": "integer", "minimum": 1, "maximum": 5},
        "structural_coherence": {"type": "integer", "minimum": 1, "maximum": 5},
        "clarity_precision": {"type": "integer", "minimum": 1, "maximum": 5},
        "voice_specificity": {"type": "integer", "minimum": 1, "maximum": 5},
        "detector_discipline": {"type": "integer", "minimum": 1, "maximum": 5},
        "delivery_usefulness": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "decision": {"type": "string", "enum": ["pass", "fail", "needs-review"]},
    "notes": {"type": "string"}
  }
}
